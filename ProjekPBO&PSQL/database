-- TAHAP 5: PEMBUATAN VIEW AND STORED PROCEDURE
-- ========================================================

-- 1. View Khusus Farmer
CREATE OR REPLACE VIEW view_jadwal_farmer AS
SELECT 
    j.id_jadwal,
    j.tanggal,
    j.keterangan_kegiatan,
    j.text_tipe_jadwal,
    j.banyaknya_anggota,
    j.total_upah,                      
    dj.upah_diterima,                  
    j.status_global,                  
    dj.id_anggota AS id_farmer,         
    ap.nama_anggota AS nama_farmer,
    dj.status AS status_pekerjaan,     
    dj.waktu_join,                                                                                                                                                 
    l.nama_lahan,
    t.nama_tanaman,
    pl.tanggal_ditanam,
    pl.jumlah_tanaman,
    j.id_lahan
FROM jadwal j
LEFT JOIN detail_jadwal dj ON j.id_jadwal = dj.id_jadwal
LEFT JOIN anggota_perusahaan ap ON dj.id_anggota = ap.id_anggota
LEFT JOIN Lahan l ON j.id_lahan = l.id_lahan
LEFT JOIN Penanaman_Lahan pl ON l.id_lahan = pl.id_lahan AND pl.status_penanaman = 'Masih Ditanam'
LEFT JOIN Tanaman t ON pl.id_tanaman = t.id_tanaman
WHERE j.text_tipe_jadwal = 'Farmer';

-- 2. View Khusus Pengantar 
CREATE OR REPLACE VIEW view_jadwal_pengantar AS
SELECT 
    j.id_jadwal,
    j.tanggal,
    j.keterangan_kegiatan,
    j.text_tipe_jadwal,
    j.banyaknya_anggota,
    j.total_upah,                      
    dj.upah_diterima,                  
    j.status_global,                  
    dj.id_anggota AS id_pengantar,       
    ap.nama_anggota AS nama_pengantar,
    dj.status AS status_pekerjaan,     
    dj.waktu_join,                    
    p.nama_pelanggan,
    p.no_telp AS no_telp_pelanggan,
    p.detail_alamat AS alamat_tujuan,
    o.id_order AS nomor_nota,
    o.tanggal_order,
    od.jumlah_produk, 
    od.harga AS harga_produk,
    t.nama_tanaman,
    j.id_pelanggan
FROM jadwal j
LEFT JOIN detail_jadwal dj ON j.id_jadwal = dj.id_jadwal
LEFT JOIN anggota_perusahaan ap ON dj.id_anggota = ap.id_anggota
LEFT JOIN Pelanggan p ON j.id_pelanggan = p.id_pelanggan
LEFT JOIN "order" o ON p.id_pelanggan = o.id_pelanggan   
LEFT JOIN order_details od ON o.id_order = od.id_order
LEFT JOIN Tanaman t ON od.id_tanaman = t.id_tanaman
WHERE j.text_tipe_jadwal = 'Pengantar';

-- 3. View Laporan Kendala
CREATE OR REPLACE VIEW view_laporan_kendala AS
SELECT 
    l.id_laporan,
    l.waktu_lapor,
    l.isi_laporan,
    j.id_jadwal,
    j.tanggal AS tanggal_jadwal,
    j.keterangan_kegiatan,
    j.text_tipe_jadwal AS divisi_kerja,
    ap.id_anggota,
    ap.nama_anggota AS nama_pelapor,
    ap.no_telp AS no_telp_pelapor
FROM laporan_jadwal l
INNER JOIN jadwal j ON l.id_jadwal = j.id_jadwal
INNER JOIN anggota_perusahaan ap ON l.id_anggota = ap.id_anggota;

-- 4. Stored Procedure Hapus Jadwal
CREATE OR REPLACE PROCEDURE hapus_jadwal(p_id_jadwal int)
LANGUAGE plpgsql
AS $$
BEGIN
    DELETE FROM detail_jadwal WHERE id_jadwal = p_id_jadwal;
    DELETE FROM laporan_jadwal WHERE id_jadwal = p_id_jadwal;
    DELETE FROM jadwal WHERE id_jadwal = p_id_jadwal;
END;
$$;

-- 🌟 5. LOGIKA BARU: TRIGGER LOG PERUBAHAN HARGA TANAMAN (Dimasukkan ke Tahap 5)
CREATE OR REPLACE FUNCTION log_perubahan_harga_tanaman()
RETURNS TRIGGER AS $$
BEGIN
    -- Hanya mencatat ke histori jika harganya benar-benar diedit dengan nilai baru
    IF OLD.harga IS DISTINCT FROM NEW.harga THEN
        INSERT INTO histori_harga_tanaman (id_tanaman, harga_lama, harga_baru, tanggal_perubahan)
        VALUES (OLD.id_tanaman, OLD.harga, NEW.harga, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_setelah_update_harga
AFTER UPDATE OF HARGA ON Tanaman
FOR EACH ROW
EXECUTE FUNCTION log_perubahan_harga_tanaman();






