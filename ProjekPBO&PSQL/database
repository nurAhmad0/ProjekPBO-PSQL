-- ========================================================
-- TAHAP 1: PEMBUATAN TIPE ENUM KUSTOM
-- ========================================================
CREATE TYPE Metode_Penarikan AS ENUM ('Transfer', 'Cash');
CREATE TYPE tipe_jadwal AS ENUM ('Farmer', 'Pengantar');
CREATE TYPE status AS ENUM ('Belum Dikerjakan', 'Dalam Pengerjaan', 'Sudah Dikerjakan', 'Gagal / Kendala', 'Tertunda');
CREATE TYPE status_kerja AS ENUM ('Aktif', 'Tidak Aktif');
CREATE TYPE status_penanaman AS ENUM ('Masih Ditanam', 'Sudah Dipanen', 'Gagal Dipanen');
CREATE TYPE status_lahan AS ENUM ('Aktif', 'Tidak Aktif'); 

-- ========================================================
-- TAHAP 2: PEMBUATAN TABEL UTAMA (MASTER TABLES)
-- ========================================================
CREATE TABLE Role (
    id_role SERIAL PRIMARY KEY,
    nama_role VARCHAR(64) NOT NULL
);

CREATE TABLE Tanaman (
    id_tanaman SERIAL PRIMARY KEY,
    nama_tanaman VARCHAR(100) NOT NULL,
    harga NUMERIC(10, 2) NOT NULL,
    estimasi_kadaluarsa INTEGER NOT NULL 
);

CREATE TABLE Lahan (
    id_lahan SERIAL PRIMARY KEY,
    nama_lahan VARCHAR(100) NOT NULL UNIQUE, 
    luas_lahan DOUBLE PRECISION NOT NULL,
    status_lahan status_lahan NOT NULL  
);

CREATE TABLE Pelanggan (
    id_pelanggan SERIAL PRIMARY KEY,
    nama_pelanggan VARCHAR(100) NOT NULL,
    no_telp VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    detail_alamat TEXT NOT NULL
);

-- ========================================================
-- TAHAP 3: PEMBUATAN TABEL DENGAN RELASI (FOREIGN KEY)
-- ========================================================
CREATE TABLE anggota_perusahaan (
    id_anggota SERIAL PRIMARY KEY,
    nama_anggota VARCHAR(64) NOT NULL,
    no_telp VARCHAR(64) NOT NULL UNIQUE,
    tanggal_lahir DATE NOT NULL,
    email VARCHAR(64) NOT NULL UNIQUE,
    status_kerja status_kerja NOT NULL,
    saldo NUMERIC(10, 2) NOT NULL DEFAULT 0.00,
    username VARCHAR(64) NOT NULL UNIQUE,
    password VARCHAR(64) NOT NULL,
    id_role INTEGER NOT NULL,
    CONSTRAINT fk_role_anggota FOREIGN KEY (id_role) REFERENCES Role(id_role)
);

CREATE TABLE riwayat_penarikan (
    id_riwayat_penarikan SERIAL PRIMARY KEY,
    tanggal_penarikan DATE NOT NULL,
    metode_penarikan Metode_Penarikan NOT NULL,
    id_anggota INTEGER NOT NULL,
    CONSTRAINT fk_anggota_penarikan FOREIGN KEY (id_anggota) REFERENCES anggota_perusahaan(id_anggota)
);

CREATE TABLE jadwal (   
    id_jadwal SERIAL PRIMARY KEY,
    tanggal DATE NOT NULL,
    keterangan_kegiatan VARCHAR(255) NOT NULL,
    text_tipe_jadwal tipe_jadwal NOT NULL, 
    banyaknya_anggota INTEGER NOT NULL DEFAULT 0, 
    total_upah NUMERIC(10, 2) NOT NULL DEFAULT 0.00,
    status_global status NOT NULL DEFAULT 'Belum Dikerjakan',
    id_lahan INTEGER,
    id_pelanggan INTEGER,
    CONSTRAINT fk_lahan_jadwal FOREIGN KEY (id_lahan) REFERENCES Lahan(id_lahan),
    CONSTRAINT fk_pelanggan_jadwal FOREIGN KEY (id_pelanggan) REFERENCES Pelanggan(id_pelanggan)
);

CREATE TABLE detail_jadwal (
    id_detail_jadwal SERIAL PRIMARY KEY,
    status status NOT NULL DEFAULT 'Belum Dikerjakan', 
    waktu_join TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, 
    upah_diterima NUMERIC(10, 2) NOT NULL DEFAULT 0.00,
    id_jadwal INTEGER NOT NULL,
    id_anggota INTEGER NOT NULL,
    CONSTRAINT fk_jadwal_detail FOREIGN KEY (id_jadwal) REFERENCES jadwal(id_jadwal) ON DELETE CASCADE,
    CONSTRAINT fk_anggota_detail_jadwal FOREIGN KEY (id_anggota) REFERENCES anggota_perusahaan(id_anggota) ON DELETE CASCADE
);

CREATE TABLE laporan_jadwal (
    id_laporan SERIAL PRIMARY KEY,
    isi_laporan TEXT NOT NULL,
    waktu_lapor TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, 
    id_jadwal INTEGER NOT NULL,
    id_anggota INTEGER NOT NULL, 
    CONSTRAINT fk_jadwal_laporan FOREIGN KEY (id_jadwal) REFERENCES jadwal(id_jadwal) ON DELETE CASCADE,
    CONSTRAINT fk_anggota_laporan FOREIGN KEY (id_anggota) REFERENCES anggota_perusahaan(id_anggota) ON DELETE CASCADE
);

CREATE TABLE Penanaman_Lahan (
    id_penanaman SERIAL PRIMARY KEY,
    tanggal_ditanam DATE NOT NULL,
    jumlah_tanaman INTEGER NOT NULL,
    status_penanaman status_penanaman NOT NULL DEFAULT 'Masih Ditanam',
    id_lahan INTEGER NOT NULL,
    id_tanaman INTEGER NOT NULL,
    CONSTRAINT fk_lahan_penanaman FOREIGN KEY (id_lahan) REFERENCES Lahan(id_lahan),
    CONSTRAINT fk_tanaman_penanaman FOREIGN KEY (id_tanaman) REFERENCES Tanaman(id_tanaman)
);

CREATE TABLE gudang (
    id_gudang SERIAL PRIMARY KEY,
    nama_gudang VARCHAR(100) NOT NULL UNIQUE, 
    stock NUMERIC(10, 2) NOT NULL,
    tanggal_masuk DATE NOT NULL,
    id_tanaman INTEGER NOT NULL,
    CONSTRAINT fk_tanaman_gudang FOREIGN KEY (id_tanaman) REFERENCES Tanaman(id_tanaman)
);

CREATE TABLE "order" (
    id_order SERIAL PRIMARY KEY,
    tanggal_order DATE NOT NULL,
    id_anggota INTEGER NOT NULL, 
    id_pelanggan INTEGER NOT NULL,
    CONSTRAINT fk_anggota_order FOREIGN KEY (id_anggota) REFERENCES anggota_perusahaan(id_anggota),
    CONSTRAINT fk_pelanggan_order FOREIGN KEY (id_pelanggan) REFERENCES Pelanggan(id_pelanggan)
);

CREATE TABLE order_details (
    id_order_details SERIAL PRIMARY KEY,
    harga NUMERIC(10, 2) NOT NULL,
    jumlah_produk NUMERIC(10, 2) NOT NULL,
    id_order INTEGER NOT NULL,
    id_tanaman INTEGER NOT NULL,
    CONSTRAINT fk_order_header FOREIGN KEY (id_order) REFERENCES "order"(id_order),
    CONSTRAINT fk_tanaman_order_detail FOREIGN KEY (id_tanaman) REFERENCES Tanaman(id_tanaman)
);

-- 🌟 TABEL BARU: HISTORI HARGA TANAMAN (Dimasukkan ke Tahap 3)
CREATE TABLE histori_harga_tanaman (
    id_histori SERIAL PRIMARY KEY,
    id_tanaman INTEGER NOT NULL,
    harga_lama NUMERIC(10, 2) NOT NULL,
    harga_baru NUMERIC(10, 2) NOT NULL,
    tanggal_perubahan TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_tanaman_histori_harga FOREIGN KEY (id_tanaman) REFERENCES Tanaman(id_tanaman) ON DELETE CASCADE
);

CREATE INDEX idx_lahan_luas ON Lahan(luas_lahan);
CREATE INDEX idx_histori_tanaman ON histori_harga_tanaman(id_tanaman); -- Indeks pelengkap histori

